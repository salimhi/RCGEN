# ============================================================
# PracticeRC Environment Configuration Template
# Copy this file to .env and configure values as needed.
# NEVER commit your actual .env file or real API keys!
# ============================================================

# --- Google Gemini AI API Configuration ---
# Your Google AI Studio API key (called ONLY from server-side; NEVER prefixed with VITE_)
GEMINI_API_KEY=

# Fast model identifier (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum time budget in ms before falling back to rule-based questions (default: 20000)
AI_TIME_BUDGET_MS=20000

# --- Rate Limiting & Usage Caps ---
# Maximum AI generations allowed per client IP per hour (default: 10)
AI_HOURLY_CAP=10

# Maximum global AI generations allowed across the entire app per day (default: 100)
AI_DAILY_CAP=100

# Salt string used to anonymize client IP addresses via SHA-256
LIMIT_SALT=rc-generation-salt-change-in-production

# --- Supabase Configuration (Optional for local dev, Required for production) ---
# In local dev without Supabase, the app automatically runs in offline local mode (.data/storage.json).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google OAuth (Optional) ---
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
